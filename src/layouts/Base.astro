---
import '@fontsource/gilda-display/latin-400.css';
import '@fontsource-variable/libre-franklin/wght.css';
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../site.config';
import { url } from '../lib/format';
import portrait from '../assets/portrait.jpg';
import { getImage } from 'astro:assets';

interface Props { title?: string; description?: string }
const { title, description = site.description } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.fields.join(', ')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: portrait, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'jpg' });
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="sitemap" href={url('sitemap-index.xml')} />
  <meta name="theme-color" content="#F3F0E9" media="(prefers-color-scheme: light)" />
  <meta name="theme-color" content="#0E1310" media="(prefers-color-scheme: dark)" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(og.src, Astro.site)} />
  <meta name="twitter:card" content="summary_large_image" />
  <!-- Theme before first paint: Auto (system) unless the visitor chose Light or Dark. -->
  <script is:inline>
    (function () {
      var apply = function () {
        try { var m = localStorage.getItem('theme'); if (m === 'light' || m === 'dark') document.documentElement.setAttribute('data-theme', m); else document.documentElement.removeAttribute('data-theme'); } catch (e) {}
      };
      apply();
      document.addEventListener('astro:after-swap', apply);
    })();
  </script>
  <ClientRouter />
</head>
<body>
  <a class="skip caps" href="#main">Skip to content</a>
  <Header />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer />
  <script>
    // Wide formulas and code blocks scroll sideways on small screens: make those reachable by keyboard.
    const scrollers = () => document.querySelectorAll<HTMLElement>('.katex-display, pre').forEach((el) => {
      const wide = el.scrollWidth > el.clientWidth + 1;
      if (wide) { el.tabIndex = 0; el.setAttribute('role', 'region'); el.setAttribute('aria-label', el.matches('pre') ? 'Code, scrollable' : 'Formula, scrollable'); }
      else if (el.getAttribute('role') === 'region') { el.removeAttribute('tabindex'); el.removeAttribute('role'); el.removeAttribute('aria-label'); }
    });
    document.addEventListener('astro:page-load', scrollers);
    addEventListener('resize', scrollers);
  </script>
</body>
</html>
