---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { getCollection } from 'astro:content';
import { monthShort, links } from '../lib/format';

const talks = (await getCollection('talks')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const years = [...new Set(talks.map((t) => t.data.date.getUTCFullYear()))];
const kind = { invited: 'Invited', contributed: 'Talk', seminar: 'Seminar', school: 'School', organiser: 'Organiser' } as const;
---
<Base title="Talks" description="Conference talks and seminars by Thomas Peyrat.">
  <PageHead title="Talks" />
  <div class="wrap">
    {years.map((y) => (
      <section class="year-block grid" aria-labelledby={`t${y}`}>
        <h2 class="year" id={`t${y}`}>{y}</h2>
        <ul class="rows">
          {talks.filter((t) => t.data.date.getUTCFullYear() === y).map((t) => (
            <li class="row talk">
              <span class="t">{t.data.url ? <a class="u" href={t.data.url} rel="noopener">{t.data.event}</a> : t.data.event}</span>
              <span class="side caps">{monthShort(t.data.date)} · {kind[t.data.kind]}</span>
              <p class="sub">
                {t.data.city}, {t.data.country}
                {t.data.title && <> · <i>{t.data.title}</i></>}
                {t.data.session && <> · {t.data.session}</>}
                {t.data.slides && <> · <a class="u caps" href={links.file(t.data.slides)}>Slides</a></>}
              </p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
