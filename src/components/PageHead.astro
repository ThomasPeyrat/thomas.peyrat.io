---
interface Props { eyebrow: string; title: string; lede?: string; long?: boolean }
const { eyebrow, title, lede, long = false } = Astro.props;
---
<header class:list={['page-head', 'grid', 'wrap', { long }]}>
  <p class="eyebrow caps">{eyebrow}</p>
  <h1 transition:name="page-title">{title}</h1>
  {lede && <p class="lede">{lede}</p>}
  <slot />
</header>
